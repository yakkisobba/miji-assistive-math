<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- ══ TOP BAR ══ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/tvModuleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Addition"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/accent" />
            </RelativeLayout>

            <!-- ══ PROGRESS CARD ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Question 1 of 5"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/white"
                        android:alpha="0.75" />

                    <TextView
                        android:id="@+id/tvScoreLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Score: 0"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/accent" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progressTint="@color/accent"
                    android:progressBackgroundTint="#2A2A2A"
                    android:max="5"
                    android:progress="1" />
            </LinearLayout>

            <!-- ══ QUESTION CARD ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Solve:"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/white"
                    android:alpha="0.55" />

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="3 + 5 = ?"
                    android:textSize="48sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvQuestionPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;three plus five&quot;"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/white"
                    android:alpha="0.55" />
            </LinearLayout>

            <!-- ══ READ QUESTION BUTTON ══ -->
            <LinearLayout
                android:id="@+id/btnReadQuestion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="Read Question"
                    android:scaleType="fitCenter"
                    app:tint="#0D0D0D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read Question Aloud"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#0D0D0D" />
            </LinearLayout>

            <!-- ══ YOUR ANSWER SECTION ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Your Answer"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etAnswer"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_surface"
                    android:paddingHorizontal="16dp"
                    android:hint="Type here..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="numberDecimal|numberSigned"
                    android:singleLine="true" />

                <FrameLayout
                    android:id="@+id/btnMic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="Voice Input"
                        android:scaleType="fitCenter"
                        app:tint="@color/accent" />
                </FrameLayout>
            </LinearLayout>

            <!-- ══ SUBMIT BUTTON ══ -->
            <LinearLayout
                android:id="@+id/btnSubmitAnswer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSubmitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit Answer"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#0D0D0D" />
            </LinearLayout>

            <!-- ══ FEEDBACK CARD (hidden until answered) ══ -->
            <LinearLayout
                android:id="@+id/cardFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Correct!"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/tvSolutionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/white"
                    android:alpha="0.75"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- ══ NEXT / FINISH BUTTON (hidden until answered) ══ -->
            <LinearLayout
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Question"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#0D0D0D" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ BOTTOM NAV (pinned) ══ -->
    <include
        layout="@layout/bottom_nav"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>